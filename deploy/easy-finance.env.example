# Copy to /etc/easy-finance.env (root-owned, mode 600). This is NOT auto-loaded.
APP_ROOT_PATH=/ef
APP_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
COOKIE_SECURE=true
DATABASE_URL=sqlite:////var/lib/easy-finance/easy_finance.db
UPLOAD_DIR=/var/lib/easy-finance/uploads
MAX_UPLOAD_MB=8

# Optional: leave empty to use local image storage. OCR always runs locally.
AZURE_STORAGE_CONNECTION_STRING=
